# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS builder

ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}

ARG FRONTEND_BUILD_MODE=production

RUN corepack enable

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY packages ./packages
COPY front-public ./front-public
COPY login ./login
COPY agent-front ./agent-front
COPY reimburse-front ./reimburse-front
COPY summary-front ./summary-front
COPY file-server ./file-server
COPY resume-template ./resume-template

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @super-pro/front-public exec tsc -b
RUN pnpm --filter @super-pro/front-public exec vite build --mode=${FRONTEND_BUILD_MODE}
RUN pnpm --filter @super-pro/login exec tsc -b
RUN pnpm --filter @super-pro/login exec vite build --mode=${FRONTEND_BUILD_MODE}
RUN pnpm --filter @super-pro/agent-front exec tsc -b
RUN pnpm --filter @super-pro/agent-front exec vite build --mode=${FRONTEND_BUILD_MODE}
RUN pnpm --filter @super-pro/reimburse-front exec tsc -b
RUN pnpm --filter @super-pro/reimburse-front exec vite build --mode=${FRONTEND_BUILD_MODE}
RUN pnpm --filter @super-pro/summary-front exec tsc -b
RUN pnpm --filter @super-pro/summary-front exec vite build --mode=${FRONTEND_BUILD_MODE}
RUN pnpm --filter @super-pro/file-server exec tsc -b
RUN pnpm --filter @super-pro/file-server exec vite build --mode=${FRONTEND_BUILD_MODE}
RUN pnpm --filter @super-pro/resume-template build

FROM nginx:1.27-alpine

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/front-public/dist /usr/share/nginx/html/zwpsite
COPY --from=builder /workspace/login/dist /usr/share/nginx/html/login
COPY --from=builder /workspace/agent-front/dist /usr/share/nginx/html/agent
COPY --from=builder /workspace/reimburse-front/dist /usr/share/nginx/html/reimburse
COPY --from=builder /workspace/summary-front/dist /usr/share/nginx/html/summary-front
COPY --from=builder /workspace/file-server/dist /usr/share/nginx/html/file-server
COPY --from=builder /workspace/resume-template/dist /usr/share/nginx/html/resume
