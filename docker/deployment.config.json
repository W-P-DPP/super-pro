{
  "projects": [
    {
      "service": "general-server",
      "kind": "api",
      "dir": "general-server",
      "port": 30010,
      "routes": ["/api/", "/public/"],
      "health": "/ready",
      "depends": ["mysql", "redis"],
      "runtimeVolumes": [
        "logs:/app/logs",
        "file:/data/file",
        "rubbish:/data/rubbish",
        "upload-chunks:/data/upload-chunks"
      ]
    },
    {
      "service": "admin-front",
      "kind": "frontend",
      "dir": "admin-front",
      "port": 80,
      "routes": ["/admin/"]
    },
    {
      "service": "front-public",
      "kind": "frontend",
      "dir": "front-public",
      "port": 80,
      "routes": ["/zwpsite/"],
      "rootRedirect": "/zwpsite/"
    },
    {
      "service": "login",
      "kind": "frontend",
      "dir": "login",
      "port": 80,
      "routes": ["/login/"]
    },
    {
      "service": "file-server",
      "kind": "frontend",
      "dir": "file-server",
      "port": 80,
      "routes": ["/file-server/"]
    },
    {
      "service": "resume-template",
      "kind": "frontend",
      "dir": "resume-template",
      "port": 80,
      "routes": ["/resume/"]
    }
  ]
}
