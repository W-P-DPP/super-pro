{
  "name": "super-pro",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:all": "turbo run dev --parallel",
    "dev:agent": "pnpm --filter @super-pro/dp-work",
    "dev:admin-front": "pnpm --filter @super-pro/admin-front dev",
    "dev:shared": "turbo run dev --filter=@super-pro/shared-* --parallel",
    "build:admin-front": "pnpm --filter @super-pro/admin-front build",
    "dev:front-public": "pnpm --filter @super-pro/front-public dev",
    "dev:login": "pnpm --filter @super-pro/login dev",
    "dev:file-server": "pnpm --filter @super-pro/file-server dev",
    "dev:resume-template": "pnpm --filter @super-pro/resume-template dev",
    "build:file-server": "pnpm --filter @super-pro/file-server build",
    "build:resume-template": "pnpm --filter @super-pro/resume-template build",
    "test:file-server": "pnpm --filter @super-pro/file-server test",
    "dev:server": "node scripts/kill-port.cjs 31010 && pnpm --filter @super-pro/server dev",
    "kill:port": "node scripts/kill-port.cjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "build:shared": "turbo run build --filter=@super-pro/shared-*",
    "test": "turbo run test",
    "test:shared": "turbo run test --filter=@super-pro/shared-*",
    "test:unit": "pnpm --filter @super-pro/server test:unit",
    "test:integration": "pnpm --filter @super-pro/server test:integration",
    "test:coverage": "pnpm --filter @super-pro/server test:coverage",
    "stress": "pnpm --filter @super-pro/server stress",
    "docker:prod:deploy": "node scripts/docker-compose-run.cjs prod deploy",
    "docker:test:deploy": "node scripts/docker-compose-run.cjs test deploy",
    "typecheck:shared": "turbo run build --filter=@super-pro/tsconfig --filter=@super-pro/shared-*"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  }
}
